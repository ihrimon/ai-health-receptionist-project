# ====== App ======
NODE_ENV=development
API_PORT=3001
DASHBOARD_PORT=3000

# ====== PostgreSQL for storage ======
POSTGRES_HOST=localhost
# Host port for the Postgres container. Not 5432 (clashes with a Postgres
# installed on Windows) and not 5433–5632: Windows often reserves that range
# for Hyper-V (`netsh int ipv4 show excludedportrange protocol=tcp`), and
# WSL then can't forward it to localhost.
POSTGRES_PORT=55432
POSTGRES_USER=brainstack
POSTGRES_PASSWORD=brainstack
POSTGRES_DB=brainstack_booking
# What the API and the Prisma CLI actually connect with — keep its port in
# sync with POSTGRES_PORT (the host port docker-compose maps Postgres to).
DATABASE_URL=postgresql://brainstack:brainstack@localhost:55432/brainstack_booking
# Row-Level Security (M7-1). The API should connect as the restricted
# `brainstack_app` role (not a superuser, not the table owner), because
# Postgres policies do not apply to superusers: with the docker superuser
# above, RLS is silently off in development. To turn it on locally:
#   1. pnpm --filter api prisma:deploy     (the migration creates the role)
#   2. pnpm --filter api db:app-role       (lets it log in, dev password)
#   3. set DATABASE_ADMIN_URL to the line above (owner: migrations, pg-boss)
#      and DATABASE_URL to the app role:
# DATABASE_ADMIN_URL=postgresql://brainstack:brainstack@localhost:55432/brainstack_booking
# DATABASE_URL=postgresql://brainstack_app:brainstack_app@localhost:55432/brainstack_booking
# Unset, DATABASE_URL is used for everything, as before. Integration tests
# set both themselves.
# true when POSTGRES_HOST is a managed free-tier provider (Neon, Supabase,
# etc.) that requires TLS — leave unset for local/Docker Postgres.
POSTGRES_SSL=false

# ====== Background jobs ======
# Jobs (knowledge indexing) run on pg-boss in the same Postgres; no Redis.
# How often an idle worker checks for new jobs, in seconds.
# QUEUE_POLLING_INTERVAL_SECONDS=2

# ====== Dashboard auth ======
# Accounts are created by signing up (POST /v1/auth/register); sessions live
# in Postgres. To reach the platform-level Settings (LLM keys) page, make
# your own account a platform admin:
#   pnpm --filter api user:platform-admin you@example.com
# Links in verification/reset emails point here:
DASHBOARD_URL=http://localhost:3000
# Widget loader script in the embed snippet. Unset, it is
# DASHBOARD_URL/chatbot.js: the dashboard's copy, which opens the
# dashboard's own /w/:publicId page with no domain check. Set it to
# <API URL>/chatbot.js (e.g. http://localhost:3001/chatbot.js) to use the
# page the API serves, framed only by each chatbot's allowed domains (M4-19).
# WIDGET_LOADER_URL=
# Origin of the widget app (apps/widget). The API opens CORS to it for the
# public chat API only, without cookies. Leave unset locally (:3002).
# WIDGET_URL=
# Where the API finds the widget's static build (index.html, assets/,
# chatbot.js). Defaults to apps/widget/dist; run `pnpm build` first.
# WIDGET_DIST_DIR=
# Number of reverse-proxy hops in front of the API (e.g. 1 on Render/nginx),
# so rate limits see the real client IP. Leave unset locally.
TRUST_PROXY=

# ====== LLM API key(s) for chat ======
# Not configured here. Each company adds its own key in the dashboard
# (Settings → AI); the dashboard's test chat runs on it. The platform-admin
# Settings page keeps the platform's keys for the old /chat demo only.
#
# Encrypts the companies' keys in the database. Required in production;
# generate with: openssl rand -base64 32
# Left empty locally, a fixed development key is used. In production the API
# refuses to start without it (M7-27).
LLM_KEY_ENCRYPTION_KEY=
# Admin usage/cost estimate (M6-12), all optional: USD per million tokens,
# share of chat on a platform key (0 = companies pay), monthly plan prices.
# ADMIN_LLM_PRICE_IN=0.15
# ADMIN_LLM_PRICE_OUT=0.6
# ADMIN_PLATFORM_KEY_SHARE=0
# ADMIN_PLAN_PRICE_STARTER=29
# ADMIN_PLAN_PRICE_GROWTH=99
# Signs the widget's conversation tokens. In production the API refuses to
# start without it (M7-27).
# openssl rand -base64 32
CONVERSATION_TOKEN_SECRET=

# ====== Knowledge base / RAG (local embeddings — no API key or quota) ======
KNOWLEDGE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KNOWLEDGE_TOP_K=5
# Below this cosine similarity (and with no word match) a chunk is not used
# to answer; with nothing left the bot sends its fallback message.
KNOWLEDGE_MIN_SIMILARITY=0.3
# A question this similar to a custom answer's trigger question gets that
# answer as written, without the model.
KNOWLEDGE_CUSTOM_ANSWER_THRESHOLD=0.7

# ====== Transactional email (dev: plain Gmail SMTP — no domain/DNS setup) ======
# EMAIL_USER is the sending Gmail address; EMAIL_APP_PASSWORD is a 16-char
# "App Password" from myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled on that account) — NOT the account's normal login
# password. Leave both unset to disable outgoing email.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=BrainStack AI Receptionist
# New-lead email to the workspace owners (M5-6): seconds to wait after a
# lead is first saved, so details given right after are in the same email.
# LEAD_NOTIFY_DELAY_SECONDS=60

# ====== File storage (S3-compatible, M0 decision T9) ======
# Local: the MinIO container in docker-compose.yml (console on :9001).
# Production: Cloudflare R2 or AWS S3; set S3_FORCE_PATH_STYLE=false there.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brainstack-local
S3_ACCESS_KEY_ID=brainstack
S3_SECRET_ACCESS_KEY=brainstack-dev-secret
S3_FORCE_PATH_STYLE=true
# Create the bucket on first upload if missing (default: on outside production).
# S3_CREATE_BUCKET=true

# ====== Sentry for error tracking ======
SENTRY_DSN=

# Most database connections one API process opens (default 10). Measured in
# the M7-5 load test: raising it from 10 to 40 did not help on a 4-core machine.
# DATABASE_POOL_MAX=10

# Local load test only (docs/design/m7-5-load-test.md). Set by `pnpm --filter api
# test:load:api`, never by hand. LOAD_TEST_MODE swaps every LLM provider for a
# fake one and the API refuses to start with it when NODE_ENV=production.
# LOAD_TEST_MODE=true
# LOAD_TEST_RATE_LIMIT_FACTOR=1000
# LOAD_TEST_FAKE_FIRST_TOKEN_MS=300
# LOAD_TEST_FAKE_TOKEN_MS=20
# LOAD_TEST_FAKE_TOKENS=40
