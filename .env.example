# ====== App ======
NODE_ENV=development
API_PORT=3001
DASHBOARD_PORT=3000

# ====== PostgreSQL for storage ======
POSTGRES_HOST=localhost
# Host port for the Postgres container. Not 5432 (clashes with a Postgres
# installed on Windows) and not 5433–5632: Windows often reserves that range
# for Hyper-V (`netsh int ipv4 show excludedportrange protocol=tcp`), and
# WSL then can't forward it to localhost.
POSTGRES_PORT=55432
POSTGRES_USER=brainstack
POSTGRES_PASSWORD=brainstack
POSTGRES_DB=brainstack_booking
# What the API and the Prisma CLI actually connect with — keep its port in
# sync with POSTGRES_PORT (the host port docker-compose maps Postgres to).
DATABASE_URL=postgresql://brainstack:brainstack@localhost:55432/brainstack_booking
# true when POSTGRES_HOST is a managed free-tier provider (Neon, Supabase,
# etc.) that requires TLS — leave unset for local/Docker Postgres.
POSTGRES_SSL=false

# ====== Background jobs ======
# Jobs (knowledge indexing) run on pg-boss in the same Postgres; no Redis.
# How often an idle worker checks for new jobs, in seconds.
# QUEUE_POLLING_INTERVAL_SECONDS=2

# ====== Dashboard auth ======
# Accounts are created by signing up (POST /v1/auth/register); sessions live
# in Postgres. To reach the platform-level Settings (LLM keys) page, make
# your own account a platform admin:
#   pnpm --filter api user:platform-admin you@example.com
# Links in verification/reset emails point here:
DASHBOARD_URL=http://localhost:3000
# Widget loader script in the embed snippet. Leave unset: it defaults to
# DASHBOARD_URL/chatbot.js (the dashboard serves the early-MVP widget).
# WIDGET_LOADER_URL=
# Number of reverse-proxy hops in front of the API (e.g. 1 on Render/nginx),
# so rate limits see the real client IP. Leave unset locally.
TRUST_PROXY=

# ====== LLM API key(s) for chat ======
# Not configured here. Each company adds its own key in the dashboard
# (Settings → AI); the dashboard's test chat runs on it. The platform-admin
# Settings page keeps the platform's keys for the old /chat demo only.
#
# Encrypts the companies' keys in the database. Required in production;
# generate with: openssl rand -base64 32
# Left empty locally, a fixed development key is used.
LLM_KEY_ENCRYPTION_KEY=
# Signs the widget's conversation tokens; required in production.
# openssl rand -base64 32
CONVERSATION_TOKEN_SECRET=

# ====== Knowledge base / RAG (local embeddings — no API key or quota) ======
KNOWLEDGE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KNOWLEDGE_TOP_K=3
# Below this cosine similarity (and with no word match) a chunk is not used
# to answer; with nothing left the bot sends its fallback message.
KNOWLEDGE_MIN_SIMILARITY=0.3
# A question this similar to a custom answer's trigger question gets that
# answer as written, without the model.
KNOWLEDGE_CUSTOM_ANSWER_THRESHOLD=0.8

# ====== Transactional email (dev: plain Gmail SMTP — no domain/DNS setup) ======
# EMAIL_USER is the sending Gmail address; EMAIL_APP_PASSWORD is a 16-char
# "App Password" from myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled on that account) — NOT the account's normal login
# password. Leave both unset to disable outgoing email.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=BrainStack AI Receptionist

# ====== File storage (S3-compatible, M0 decision T9) ======
# Local: the MinIO container in docker-compose.yml (console on :9001).
# Production: Cloudflare R2 or AWS S3; set S3_FORCE_PATH_STYLE=false there.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brainstack-local
S3_ACCESS_KEY_ID=brainstack
S3_SECRET_ACCESS_KEY=brainstack-dev-secret
S3_FORCE_PATH_STYLE=true
# Create the bucket on first upload if missing (default: on outside production).
# S3_CREATE_BUCKET=true

# ====== Sentry for error tracking ======
SENTRY_DSN=
