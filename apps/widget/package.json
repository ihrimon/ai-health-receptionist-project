{
  "name": "widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && vite",
    "build": "node init && tsc --noEmit && vite build && pnpm build:loader",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "build:loader": "node init && vite build --config vite.loader.config.ts",
    "build:loader:dashboard": "node init && vite build --config vite.loader.config.ts --mode dashboard"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@brainstack/shared": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
