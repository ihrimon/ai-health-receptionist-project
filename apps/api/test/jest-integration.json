{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/integration/global-setup.ts",
  "setupFiles": ["<rootDir>/integration/setup-env.ts"],
  "testTimeout": 60000
}
