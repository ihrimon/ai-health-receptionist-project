// Single source of truth for the database schema (M0 decision T15/D10).
// Change it, then run `pnpm --filter api prisma:migrate` to generate a
// migration. SQL Prisma can't express (extensions, CHECK constraints,
// expression indexes) goes into a migration created with
// `prisma migrate dev --create-only` — see docs/design/d1-data-model.md §4.
//
// IDs default in the database (gen_random_uuid()), not in Prisma Client,
// so rows inserted with raw SQL (KnowledgeService) get one too.
//
// Identity and tenancy (User, Workspace, WorkspaceMember, Session,
// EmailToken) and Chatbot/ChatbotVersion follow docs/design/d1-data-model.md.

generator client {
  provider            = "prisma-client"
  // Inside src/ so `nest build` (tsc) compiles it with the rest of the app;
  // the API's tsconfig sets no rootDir, so code outside src/ isn't safe to
  // import (see CLAUDE.md).
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless relative imports: ts-node (CLI scripts) and Jest run
  // the generated .ts sources directly and can't resolve the default ".js".
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  VIEWER

  @@map("workspace_role")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED

  @@map("workspace_status")
}

/// Set by hand by the platform team until billing exists (M7-0; M6 replaces it with a plans table).
enum WorkspacePlan {
  BETA
  STARTER
  GROWTH

  @@map("workspace_plan")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_type")
}

enum ChatbotStatus {
  ENABLED
  DISABLED

  @@map("chatbot_status")
}

enum KnowledgeSourceType {
  /// Written in the dashboard (Markdown).
  POLICY
  /// Any other business information (Markdown).
  TEXT
  /// Uploaded PDF/DOCX/TXT/MD (M2-10).
  DOCUMENT
  /// Website crawl (P1).
  URL

  @@map("knowledge_source_type")
}

/// Where a knowledge source is in the indexing pipeline (M2-11).
enum IngestStatus {
  QUEUED
  PROCESSING
  READY
  FAILED

  @@map("ingest_status")
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN

  @@map("stock_status")
}

// ─────────────────── Identity & tenancy (M1) ───────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercase (CHECK constraint in the migration SQL).
  email           String    @unique @db.VarChar(255)
  /// argon2id (M0 decision T5).
  passwordHash    String    @map("password_hash")
  name            String    @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  /// Super-admin console access (M7-0).
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships              WorkspaceMember[]
  auditLogs                AuditLog[]
  sessions                 Session[]
  emailTokens              EmailToken[]
  /// Chatbot versions this user published.
  publishedChatbotVersions ChatbotVersion[]

  @@map("users")
}

/// The tenant. Deleting one cascades to everything it owns (NFR-7).
/// `planId` arrives with the Plan model (M6/M7).
model Workspace {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(100)
  slug      String          @unique @db.VarChar(60)
  status    WorkspaceStatus @default(ACTIVE)
  plan      WorkspacePlan   @default(BETA)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  members         WorkspaceMember[]
  chatbots        Chatbot[]
  chatbotVersions ChatbotVersion[]
  faqs            Faq[]
  customAnswers   CustomAnswer[]
  sources         KnowledgeSource[]
  products        Product[]
  knowledgeChunks KnowledgeChunk[]
  llmKeys         WorkspaceLlmKey[]
  conversations   Conversation[]
  messages        Message[]
  usageCounters   UsageCounter[]
  leads           Lead[]
  /// Sessions currently switched to this workspace.
  activeSessions  Session[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// Dashboard login session. The cookie holds the raw token; only its
/// SHA-256 hash is stored.
model Session {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  userId            String   @map("user_id") @db.Uuid
  activeWorkspaceId String?  @map("active_workspace_id") @db.Uuid
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  userAgent         String?  @map("user_agent") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cleared when the workspace is deleted; the user then picks another.
  activeWorkspace Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  /// For the expired-session cleanup job.
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time email verification / password reset token, stored hashed.
model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz
  usedAt    DateTime?      @map("used_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// ─────────────── Chatbot and its published versions (M2) ───────────────

/// One per workspace in the MVP (M0 decision B2), created together with the
/// workspace. FAQs, custom answers and knowledge sources belong to it.
model Chatbot {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String        @map("workspace_id") @db.Uuid
  /// "cb_" + 16 random characters; goes in the embed snippet.
  publicId            String        @unique @map("public_id") @db.VarChar(24)
  status              ChatbotStatus @default(ENABLED)
  /// ChatbotConfig (packages/shared, docs/design/d4-chatbot-config.md),
  /// edited freely; the live config is publishedVersion.config.
  draftConfig         Json          @map("draft_config")
  /// The live version; null until the first publish.
  publishedVersionId  String?       @unique @map("published_version_id") @db.Uuid
  /// Sites allowed to embed the widget, e.g. "shop.example.com",
  /// "*.example.com" (enforced with frame-ancestors CSP in M4).
  allowedDomains      String[]      @default([]) @map("allowed_domains")
  /// When the widget page was first loaded inside an allowed site
  /// ("Verify installation", FR-3.5, M4-14); null until then, and reset
  /// when that site leaves allowedDomains.
  installVerifiedAt   DateTime?     @map("install_verified_at") @db.Timestamptz
  /// That site as host[:port], e.g. "shop.example.com".
  installVerifiedHost String?       @map("install_verified_host") @db.VarChar(260)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedVersion ChatbotVersion?   @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         ChatbotVersion[]  @relation("ChatbotVersions")
  faqs             Faq[]
  customAnswers    CustomAnswer[]
  sources          KnowledgeSource[]
  products         Product[]
  chunks           KnowledgeChunk[]
  conversations    Conversation[]
  leads            Lead[]

  @@index([workspaceId])
  @@map("chatbots")
}

/// An immutable copy of a chatbot's draft config, made on each publish
/// (D-1 decision 5). Kept for rollback (FR-6.6).
model ChatbotVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  chatbotId     String   @map("chatbot_id") @db.Uuid
  /// 1, 2, 3… per chatbot.
  version       Int
  config        Json
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot     Chatbot   @relation("ChatbotVersions", fields: [chatbotId], references: [id], onDelete: Cascade)
  publishedBy User?     @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedOf Chatbot?  @relation("PublishedVersion")

  @@unique([chatbotId, version])
  @@index([workspaceId])
  @@map("chatbot_versions")
}

// ───────────────────── Knowledge (M2-6) ─────────────────────
// Saved knowledge is live right away; only the chatbot config has a draft
// (D-4 question 2). Item caps per chatbot: KNOWLEDGE_LIMITS in packages/shared.

model Faq {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  chatbotId   String   @map("chatbot_id") @db.Uuid
  question    String   @db.VarChar(500)
  /// ≤ 4000 characters (checked by the API).
  answer      String
  /// Display order in the dashboard; new FAQs go last.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot          @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([workspaceId, chatbotId])
  @@map("faqs")
}

/// "When asked X, answer exactly Y" (FR-2.6); matched before search.
model CustomAnswer {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                      @map("workspace_id") @db.Uuid
  chatbotId       String                      @map("chatbot_id") @db.Uuid
  triggerQuestion String                      @map("trigger_question") @db.VarChar(500)
  answer          String
  /// Embedding of triggerQuestion, filled by indexing (M2-13).
  embedding       Unsupported("vector(384)")?
  embeddingModel  String?                     @map("embedding_model") @db.VarChar(100)
  isActive        Boolean                     @default(true) @map("is_active")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@index([workspaceId, chatbotId])
  @@map("custom_answers")
}

/// A policy or text page written in the dashboard, or (M2-10) an uploaded
/// document. Indexing splits it into knowledge chunks (M2-11).
model KnowledgeSource {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  chatbotId   String              @map("chatbot_id") @db.Uuid
  type        KnowledgeSourceType
  /// e.g. "Return policy".
  title       String              @db.VarChar(200)
  /// POLICY/TEXT: Markdown. DOCUMENT: the extracted text.
  content     String?
  /// DOCUMENT: S3/MinIO object key (M2-9).
  fileKey     String?             @map("file_key")
  fileName    String?             @map("file_name") @db.VarChar(255)
  /// Bytes.
  fileSize    Int?                @map("file_size")
  mimeType    String?             @map("mime_type") @db.VarChar(100)
  /// URL type (P1).
  url         String?
  status      IngestStatus        @default(QUEUED)
  /// Why indexing failed, worded for the company to read.
  error       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot          @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([workspaceId, chatbotId, type])
  @@map("knowledge_sources")
}

/// A product the bot can recommend (FR-7.4), added by hand or by CSV
/// (M2-8). Keyword search uses the hand-written products_fts index.
model Product {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                      @map("workspace_id") @db.Uuid
  chatbotId      String                      @map("chatbot_id") @db.Uuid
  /// Unique per chatbot when set; CSV import matches rows on it (M2-8).
  sku            String?                     @db.VarChar(100)
  name           String                      @db.VarChar(255)
  description    String?
  /// null = "contact us for the price".
  price          Decimal?                    @db.Decimal(12, 2)
  /// Price before a discount.
  compareAtPrice Decimal?                    @map("compare_at_price") @db.Decimal(12, 2)
  /// ISO 4217; defaults to the chatbot config's business.currency.
  currency       String                      @db.Char(3)
  stockStatus    StockStatus                 @default(UNKNOWN) @map("stock_status")
  stockQuantity  Int?                        @map("stock_quantity")
  category       String?                     @db.VarChar(100)
  url            String?
  imageUrl       String?                     @map("image_url")
  /// e.g. { "color": ["red", "blue"], "size": "M" }.
  attributes     Json                        @default("{}")
  isActive       Boolean                     @default(true) @map("is_active")
  /// Store sync (P2).
  externalId     String?                     @map("external_id")
  /// Embedding of name + category + description, filled by indexing (M2-13).
  embedding      Unsupported("vector(384)")?
  embeddingModel String?                     @map("embedding_model") @db.VarChar(100)
  /// to_tsvector of name + category + description, generated and GIN-indexed
  /// by the database for keyword search (M7-31). Never written by the app.
  searchTsv      Unsupported("tsvector")?    @default(dbgenerated()) @map("search_tsv")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  // Postgres allows several NULL skus under this unique index.
  @@unique([chatbotId, sku])
  @@index([workspaceId, chatbotId, isActive])
  @@index([workspaceId, chatbotId, category])
  @@index([searchTsv], type: Gin, map: "products_search_tsv_idx")
  @@map("products")
}

/// A workspace's own LLM API key + model (M3-21; replaces decision B3 for
/// chat). The key is encrypted with AES-256-GCM (common/secret-box.ts) and
/// never leaves the API; the dashboard sees only its last 4 characters.
/// Chat tries the active keys oldest first and is off when there are none.
model WorkspaceLlmKey {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  provider        LlmProvider
  model           String      @db.VarChar(100)
  apiKeyEncrypted String      @map("api_key_encrypted")
  keyLast4        String      @map("key_last4") @db.VarChar(4)
  isActive        Boolean     @default(true) @map("is_active")
  lastUsedAt      DateTime?   @map("last_used_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("workspace_llm_keys")
}

// ─────────────────────────── Platform ───────────────────────────

/// Which provider an LLM credential's apiKey/model belong to; selects the
/// adapter in modules/chat/providers. Groq, OpenAI, OpenRouter and UnoRouter
/// speak the OpenAI chat-completions format; Anthropic and Gemini have
/// dedicated adapters.
enum LlmProvider {
  groq
  openai
  anthropic
  gemini
  openrouter
  unorouter

  @@map("llm_provider")
}

/// Fixed-window rate-limit counters (login, signup… D-2 §5), in Postgres
/// since the MVP has no Redis (lead's call, 2026-10-14). One row per key
/// and window; expired rows are deleted now and then.
model RateLimit {
  /// e.g. `login:ip-email:1.2.3.4:a@b.com`.
  key         String   @db.VarChar(300)
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limits")
}

/// Platform-level LLM API key + model pairs managed from Settings (M0
/// decision B3: the platform pays for LLM usage). Rotated in `sortOrder`.
/// The rl* columns snapshot the provider's rate-limit headers from the most
/// recent call. apiKey is plaintext for now; encryption at rest is part of
/// the M7 security review.
model LlmCredential {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            LlmProvider @default(groq)
  apiKey              String      @map("api_key")
  model               String
  sortOrder           Int         @default(0) @map("sort_order")
  isActive            Boolean     @default(true) @map("is_active")
  lastUsedAt          DateTime?   @map("last_used_at") @db.Timestamptz
  rlLimitRequests     Int?        @map("rl_limit_requests")
  rlRemainingRequests Int?        @map("rl_remaining_requests")
  rlResetRequests     String?     @map("rl_reset_requests") @db.VarChar(50)
  rlLimitTokens       Int?        @map("rl_limit_tokens")
  rlRemainingTokens   Int?        @map("rl_remaining_tokens")
  rlResetTokens       String?     @map("rl_reset_tokens") @db.VarChar(50)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("llm_credentials")
}

/// One chat between a visitor (or a dashboard user, `isPreview`) and a
/// chatbot (M3-5). History lives on the server; the client sends only the
/// new message.
model Conversation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  chatbotId     String   @map("chatbot_id") @db.Uuid
  /// Random ID made by the widget (no personal data).
  visitorId     String   @map("visitor_id") @db.VarChar(64)
  /// Dashboard "Test chat"; left out of analytics.
  isPreview     Boolean  @default(false) @map("is_preview")
  /// The page the chat started on.
  originUrl     String?  @map("origin_url")
  /// The published version that answered, for debugging.
  versionId     String?  @map("version_id") @db.Uuid
  messageCount  Int      @default(0) @map("message_count")
  /// 1–5 stars (CHECK constraint in the migration SQL).
  rating        Int?     @db.SmallInt
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages  Message[]
  lead      Lead?

  @@index([workspaceId, chatbotId, lastMessageAt(sort: Desc)])
  @@index([chatbotId, visitorId])
  @@map("conversations")
}

/// A visitor who left their contact details in a chat (M5-5, FR-8.2).
/// Filled by the capture_lead tool (M5-4) through LeadsService.create.
/// Deleting the conversation keeps the lead and clears the link.
model Lead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  chatbotId      String    @map("chatbot_id") @db.Uuid
  /// At most one lead per conversation; null once the chat is deleted.
  conversationId String?   @unique @map("conversation_id") @db.Uuid
  name           String?   @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  /// { [QuestionToAsk.id]: "answer" } (D-4).
  answers        Json      @default("{}")
  /// The page the chat started on, copied so it outlives the conversation.
  sourceUrl      String?   @map("source_url")
  /// When the owner was emailed about it (M5-6); null until then.
  notifiedAt     DateTime? @map("notified_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot      Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([chatbotId])
  @@map("leads")
}

enum MessageRole {
  USER
  ASSISTANT
}

/// One turn of a Conversation (M3-5). Assistant rows also keep how the
/// answer was made (M3-11): sources, model, tokens and latency.
model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String      @map("workspace_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  /// [{ title, page, similarity }] the answer was built from.
  sources        Json?
  /// "llm" | "custom_answer" | "fallback"
  answeredBy     String?     @map("answered_by") @db.VarChar(20)
  model          String?     @db.VarChar(100)
  tokensIn       Int?        @map("tokens_in")
  tokensOut      Int?        @map("tokens_out")
  latencyMs      Int?        @map("latency_ms")
  /// Where that time went (AnswerTimings in packages/shared, M7-40).
  timings        Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, answeredBy, createdAt])
  @@map("messages")
}

/// How much a workspace used chat in one calendar month, UTC (M3-11). Live
/// visitor messages and dashboard "Test chat" messages are counted apart.
/// The base for the monthly quota that arrives with plans (M6/M7).
model UsageCounter {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  /// "2026-10".
  period          String   @db.Char(7)
  /// Answers to live visitors.
  messages        Int      @default(0)
  /// Answers in the dashboard Test chat.
  previewMessages Int      @default(0) @map("preview_messages")
  tokensIn        BigInt   @default(0) @map("tokens_in")
  tokensOut       BigInt   @default(0) @map("tokens_out")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
  @@map("usage_counters")
}

/// A searchable piece of an FAQ, policy, text page or document (M2-12).
/// `embedding` is written and searched only through raw SQL in
/// KnowledgeService (Prisma Client can't handle Unsupported fields).
/// Exactly one of faqId and sourceId is set (CHECK in the migration SQL);
/// keyword search uses the hand-written knowledge_chunks_fts index.
model KnowledgeChunk {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                     @map("workspace_id") @db.Uuid
  chatbotId      String                     @map("chatbot_id") @db.Uuid
  /// FAQ chunks arrive with M2-13.
  faqId          String?                    @map("faq_id") @db.Uuid
  sourceId       String?                    @map("source_id") @db.Uuid
  /// Order within its FAQ or source, from 0.
  chunkIndex     Int                        @map("chunk_index")
  content        String
  /// { title, headingPath, page } for citing where an answer came from.
  metadata       Json                       @default("{}")
  /// 384 dimensions for Xenova/all-MiniLM-L6-v2 (M0 decision T7).
  embedding      Unsupported("vector(384)")
  /// The model that made `embedding` (M2-14), so a model change can find
  /// and re-embed old chunks (M2-15).
  embeddingModel String                     @map("embedding_model") @db.VarChar(100)
  /// to_tsvector('english', content), generated and GIN-indexed by the
  /// database for keyword search (M7-31). Never written by the app.
  contentTsv     Unsupported("tsvector")?   @default(dbgenerated()) @map("content_tsv")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot   Chatbot          @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  faq       Faq?             @relation(fields: [faqId], references: [id], onDelete: Cascade)
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, chatbotId])
  @@index([faqId])
  @@index([sourceId])
  @@index([contentTsv], type: Gin, map: "knowledge_chunks_content_tsv_idx")
  @@map("knowledge_chunks")
}

/// Platform-admin actions (M7-0). Platform data, not tenant-owned: it is
/// written only by the admin module. The workspace id is a plain column
/// (no relation) so the trail survives deleting a workspace.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null once the admin's account is deleted; the email below stays.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorEmail    String   @map("actor_email") @db.VarChar(255)
  /// e.g. "workspace.suspend", "workspace.set_plan".
  action        String   @db.VarChar(60)
  workspaceId   String?  @map("workspace_id") @db.Uuid
  workspaceName String?  @map("workspace_name") @db.VarChar(100)
  /// What changed (before/after values, the reason); never message content.
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
