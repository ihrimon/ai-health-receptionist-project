{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // Prisma CLI config, not app code. Compiling it would make tsc's root
    // apps/api instead of apps/api/src, moving the output to dist/src/ and
    // breaking `node dist/main` (the Dockerfile CMD).
    "prisma.config.ts"
  ]
}
