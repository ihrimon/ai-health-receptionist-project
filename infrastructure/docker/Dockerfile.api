# Build context is the monorepo root (see docker-compose.yml).
# Debian, not Alpine: the RAG embeddings (onnxruntime-node, via
# @xenova/transformers) ship glibc binaries that don't load on Alpine's musl.
FROM node:22-bookworm-slim AS base
# Prisma's migration engine needs OpenSSL; slim images leave it out.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate
WORKDIR /repo

COPY . .
# apps/api's postinstall runs `prisma generate` (no database needed).
# The widget is installed and built too: the API serves its static build
# (apps/widget/dist) at /w/:publicId and /chatbot.js (M4-19).
RUN pnpm install --filter=api... --filter=widget...
# "api..." also builds the workspace packages it imports (@brainstack/shared).
# The widget is built without VITE_API_URL / VITE_WIDGET_URL, so the page
# calls the API on its own origin and the loader opens this origin's page.
RUN pnpm --filter=api... --filter=widget... build

# Run as the image's unprivileged `node` user, not root (M7-25). The only
# place the app writes at runtime is the embedding model cache of
# @xenova/transformers (a .cache folder inside its package, filled on the
# first embedding), so that folder is created now and handed to `node`.
# Everything else (the code, the widget build in apps/widget/dist) is only
# read; uploads are kept in memory and go to S3, not to disk.
WORKDIR /repo/apps/api
RUN CACHE="$(realpath node_modules/@xenova/transformers)/.cache"   && mkdir -p "$CACHE"   && chown -R node:node "$CACHE"
USER node
ENV NODE_ENV=production
EXPOSE 3001
# Apply pending Prisma migrations, then start. Fine for a single instance;
# with several replicas, run migrations as a separate deploy step (M7).
# The prisma binary is called directly: pnpm (via corepack) would try to
# write its own cache under the user's home at start.
# Job workers can run in their own container from this same image: PROCESS_ROLE=api
# on the API, and command `node dist/worker.js` on the worker (M7-7).
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]
